import numpy as np
import random


waypoints = np.array([
    [0, 0],
    [2, 3],
    [5, 1],
    [3, 5],
    [6, 4],
    [8, 6],
    [9, 6]
])

n = len(waypoints)
start_node = 0
goal_node = n - 1

distance = np.zeros((n, n))

for i in range(n):
    for j in range(n):
        distance[i][j] = np.linalg.norm(
            waypoints[i] - waypoints[j]
        )

allowed = np.ones((n, n))

blocked_corridors = [
    (0, 6),
    (0, 3),
    (1, 4),
    (2, 5)
]

for i, j in blocked_corridors:
    allowed[i][j] = 0
    allowed[j][i] = 0

num_ants = 10
alpha = 1
beta = 2
rho = 0.5
Q = 100
iterations = 100

initial_pheromone = 1.0
pheromone = np.ones((n, n)) * initial_pheromone

heuristic = np.zeros((n, n))

for i in range(n):
    for j in range(n):
        if i != j and allowed[i][j] == 1:
            step_dist = distance[i][j]
            dist_to_goal = distance[j][goal_node]
            heuristic[i][j] = 1 / (step_dist + 0.5 * dist_to_goal + 1e-10)

def calculate_distance(route):
    total = 0

    for i in range(len(route) - 1):
        total += distance[route[i]][route[i + 1]]

    return total

def select_next_waypoint(current, visited):

    candidates = [
        node for node in range(n)
        if node not in visited and allowed[current][node] == 1
    ]

    if not candidates:
        return None

    probabilities = []

    for node in candidates:
        value = (
            pheromone[current][node] ** alpha
            * heuristic[current][node] ** beta
        )
        probabilities.append(value)

    total = sum(probabilities)

    if total == 0:
        return None

    probabilities = [p / total for p in probabilities]

    return random.choices(
        candidates,
        weights=probabilities,
        k=1
    )[0]

best_route = None
best_distance = float("inf")

for iteration in range(iterations):

    ant_routes = []
    ant_distances = []

    for ant in range(num_ants):

        route = [start_node]
        visited = {start_node}

        while route[-1] != goal_node:

            current = route[-1]

            next_node = select_next_waypoint(
                current, visited
            )

            if next_node is None:
                break

            route.append(next_node)
            visited.add(next_node)

        if route[-1] == goal_node:

            total_distance = calculate_distance(route)

            ant_routes.append(route)
            ant_distances.append(total_distance)

            if total_distance < best_distance:
                best_distance = total_distance
                best_route = route.copy()

    pheromone *= (1 - rho)

    for route, route_distance in zip(
        ant_routes, ant_distances
    ):

        deposit = Q / route_distance

        for i in range(len(route) - 1):
            a = route[i]
            b = route[i + 1]

            pheromone[a][b] += deposit
            pheromone[b][a] += deposit

    print(
        "Iteration:", iteration + 1,
        "Best Distance:", round(best_distance, 2)
    )

print("\n----- BEST DRONE ROUTE -----")

if best_route is not None:

    print("Best Waypoint Sequence:", best_route)

    print("Coordinates:")
    for node in best_route:
        print(f"Node {node}: {waypoints[node]}")

    print(
        "Minimum Flight Distance:",
        round(best_distance, 2)
    )

else:
    print("No feasible flight route found.")
